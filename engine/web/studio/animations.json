{
 "about": "Animations des clips (textes, vidéos, images). Lues par l'aperçu (studio/anim.js) et par l'export (engine/timeline/animations.py). Images clés [progression 0..1, propriétés, courbe du segment suivant]. Propriétés : o opacité, dx/dy décalage (fraction du cadre), s échelle, sx/sy étirement, r rotation (degrés, sens horaire), b flou (px de sortie). Une propriété absente vaut sa valeur neutre. `per` : animation lettre à lettre (char) ou mot à mot (word) ; seules o et b s'appliquent alors à chaque lettre ou mot, `stagger` étale leurs départs.",
 "kinds": {"in": "Entrée", "out": "Sortie", "loop": "Boucle"},
 "anims": {
  "fade":        {"kind": "in", "label": "Fondu", "dur": 0.4, "ease": "linear", "kf": [[0, {"o": 0}], [1, {}]]},
  "slide_up":    {"kind": "in", "label": "Monter", "dur": 0.5, "ease": "outCubic", "kf": [[0, {"o": 0, "dy": 0.1}], [1, {}]]},
  "slide_down":  {"kind": "in", "label": "Descendre", "dur": 0.5, "ease": "outCubic", "kf": [[0, {"o": 0, "dy": -0.1}], [1, {}]]},
  "slide_left":  {"kind": "in", "label": "Arriver de droite", "dur": 0.5, "ease": "outCubic", "kf": [[0, {"o": 0, "dx": 0.25}], [1, {}]]},
  "slide_right": {"kind": "in", "label": "Arriver de gauche", "dur": 0.5, "ease": "outCubic", "kf": [[0, {"o": 0, "dx": -0.25}], [1, {}]]},
  "zoom_in":     {"kind": "in", "label": "Zoom avant", "dur": 0.5, "ease": "outCubic", "kf": [[0, {"o": 0, "s": 0.3}], [1, {}]]},
  "zoom_out":    {"kind": "in", "label": "Zoom arrière", "dur": 0.5, "ease": "outCubic", "kf": [[0, {"o": 0, "s": 1.8}], [1, {}]]},
  "pop":         {"kind": "in", "label": "Pop", "dur": 0.4, "ease": "outQuad", "kf": [[0, {"o": 0, "s": 0.2}], [0.6, {"s": 1.12}], [1, {}]]},
  "bounce":      {"kind": "in", "label": "Rebond", "dur": 0.7, "ease": "outBounce", "kf": [[0, {"o": 0, "s": 0.3}, "outQuad"], [0.15, {"s": 0.5}], [1, {}]]},
  "drop":        {"kind": "in", "label": "Chute", "dur": 0.8, "ease": "outBounce", "kf": [[0, {"o": 0, "dy": -0.3}, "linear"], [0.1, {"dy": -0.27}], [1, {}]]},
  "elastic":     {"kind": "in", "label": "Élastique", "dur": 0.9, "ease": "outElastic", "kf": [[0, {"o": 0, "s": 0}, "linear"], [0.1, {"s": 0.3}], [1, {}]]},
  "spin":        {"kind": "in", "label": "Tourbillon", "dur": 0.7, "ease": "outCubic", "kf": [[0, {"o": 0, "s": 0.2, "r": -270}], [1, {}]]},
  "rotate":      {"kind": "in", "label": "Rotation", "dur": 0.5, "ease": "outBack", "kf": [[0, {"o": 0, "r": -30}], [1, {}]]},
  "blur":        {"kind": "in", "label": "Flou", "dur": 0.5, "ease": "outQuad", "kf": [[0, {"o": 0, "b": 30}], [1, {}]]},
  "stretch":     {"kind": "in", "label": "Étirer", "dur": 0.45, "ease": "outBack", "kf": [[0, {"o": 0, "sx": 0.05}], [1, {}]]},
  "squeeze":     {"kind": "in", "label": "Déplier", "dur": 0.45, "ease": "outBack", "kf": [[0, {"o": 0, "sy": 0.05}], [1, {}]]},
  "rise":        {"kind": "in", "label": "Remontée", "dur": 0.6, "ease": "outBack", "kf": [[0, {"o": 0, "dy": 0.35}], [1, {}]]},
  "swing":       {"kind": "in", "label": "Balancier", "dur": 0.8, "ease": "inOutSine", "kf": [[0, {"o": 0, "r": 25}, "outQuad"], [0.4, {"r": -12}], [0.7, {"r": 5}], [1, {}]]},
  "typewriter":  {"kind": "in", "label": "Machine à écrire", "for": ["text"], "dur": 1.2, "ease": "linear", "per": "char", "stagger": 1, "ukf": [[0, {"o": 0}], [1, {}]]},
  "letters":     {"kind": "in", "label": "Lettre à lettre", "for": ["text"], "dur": 0.9, "ease": "outQuad", "per": "char", "stagger": 0.75, "ukf": [[0, {"o": 0, "b": 10}], [1, {}]]},
  "words":       {"kind": "in", "label": "Mot à mot", "for": ["text"], "dur": 1.0, "ease": "outQuad", "per": "word", "stagger": 0.8, "ukf": [[0, {"o": 0, "b": 6}], [1, {}]]},
  "letters_fade":{"kind": "in", "label": "Fondu lettre à lettre", "for": ["text"], "dur": 0.8, "ease": "linear", "per": "char", "stagger": 0.6, "ukf": [[0, {"o": 0}], [1, {}]]},

  "fade_out":        {"kind": "out", "label": "Fondu", "dur": 0.4, "ease": "linear", "kf": [[0, {}], [1, {"o": 0}]]},
  "slide_up_out":    {"kind": "out", "label": "Monter", "dur": 0.4, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "dy": -0.1}]]},
  "slide_down_out":  {"kind": "out", "label": "Descendre", "dur": 0.4, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "dy": 0.1}]]},
  "slide_left_out":  {"kind": "out", "label": "Partir à gauche", "dur": 0.4, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "dx": -0.25}]]},
  "slide_right_out": {"kind": "out", "label": "Partir à droite", "dur": 0.4, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "dx": 0.25}]]},
  "zoom_in_out":     {"kind": "out", "label": "Zoom avant", "dur": 0.4, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "s": 1.8}]]},
  "zoom_out_out":    {"kind": "out", "label": "Zoom arrière", "dur": 0.4, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "s": 0.3}]]},
  "pop_out":         {"kind": "out", "label": "Pop", "dur": 0.35, "ease": "inQuad", "kf": [[0, {}], [0.4, {"s": 1.12}], [1, {"o": 0, "s": 0.2}]]},
  "spin_out":        {"kind": "out", "label": "Tourbillon", "dur": 0.6, "ease": "inCubic", "kf": [[0, {}], [1, {"o": 0, "s": 0.2, "r": 270}]]},
  "rotate_out":      {"kind": "out", "label": "Rotation", "dur": 0.45, "ease": "inBack", "kf": [[0, {}], [1, {"o": 0, "r": 30}]]},
  "blur_out":        {"kind": "out", "label": "Flou", "dur": 0.45, "ease": "inQuad", "kf": [[0, {}], [1, {"o": 0, "b": 30}]]},
  "stretch_out":     {"kind": "out", "label": "Étirer", "dur": 0.4, "ease": "inBack", "kf": [[0, {}], [1, {"o": 0, "sx": 0.05}]]},
  "squeeze_out":     {"kind": "out", "label": "Replier", "dur": 0.4, "ease": "inBack", "kf": [[0, {}], [1, {"o": 0, "sy": 0.05}]]},
  "sink":            {"kind": "out", "label": "Chute", "dur": 0.5, "ease": "inBack", "kf": [[0, {}], [1, {"o": 0, "dy": 0.35}]]},
  "typewriter_out":  {"kind": "out", "label": "Effacer", "for": ["text"], "dur": 0.8, "ease": "linear", "per": "char", "stagger": 1, "reverse": true, "ukf": [[0, {}], [1, {"o": 0}]]},
  "letters_out":     {"kind": "out", "label": "Lettre à lettre", "for": ["text"], "dur": 0.8, "ease": "inQuad", "per": "char", "stagger": 0.75, "ukf": [[0, {}], [1, {"o": 0, "b": 10}]]},
  "words_out":       {"kind": "out", "label": "Mot à mot", "for": ["text"], "dur": 0.8, "ease": "inQuad", "per": "word", "stagger": 0.8, "ukf": [[0, {}], [1, {"o": 0, "b": 6}]]},

  "pulse":     {"kind": "loop", "label": "Pulsation", "period": 1.0, "ease": "inOutSine", "kf": [[0, {}], [0.5, {"s": 1.06}], [1, {}]]},
  "heartbeat": {"kind": "loop", "label": "Battement de cœur", "period": 1.2, "ease": "outQuad", "kf": [[0, {}], [0.12, {"s": 1.12}], [0.24, {}], [0.36, {"s": 1.08}], [0.5, {}], [1, {}]]},
  "float":     {"kind": "loop", "label": "Flottement", "period": 2.4, "ease": "inOutSine", "kf": [[0, {}], [0.5, {"dy": -0.012}], [1, {}]]},
  "sway":      {"kind": "loop", "label": "Balancement", "period": 2.0, "ease": "inOutSine", "kf": [[0, {"r": -3}], [0.5, {"r": 3}], [1, {"r": -3}]]},
  "shake":     {"kind": "loop", "label": "Secousse", "period": 0.35, "ease": "linear", "kf": [[0, {}], [0.2, {"dx": 0.006, "r": 1}], [0.4, {"dx": -0.006, "r": -1}], [0.6, {"dx": 0.004}], [0.8, {"dx": -0.004}], [1, {}]]},
  "blink":     {"kind": "loop", "label": "Clignotement", "period": 1.0, "ease": "linear", "kf": [[0, {}], [0.45, {}], [0.5, {"o": 0.15}], [0.95, {"o": 0.15}], [1, {}]]},
  "wobble":    {"kind": "loop", "label": "Gélatine", "period": 0.9, "ease": "inOutSine", "kf": [[0, {}], [0.25, {"sx": 1.06, "sy": 0.95}], [0.5, {"sx": 0.96, "sy": 1.04}], [0.75, {"sx": 1.03, "sy": 0.98}], [1, {}]]},
  "glitch":    {"kind": "loop", "label": "Glitch", "period": 0.6, "ease": "linear", "kf": [[0, {}], [0.1, {"dx": 0.012}], [0.14, {"dx": -0.01, "o": 0.7}], [0.18, {}], [0.62, {}], [0.66, {"dx": -0.015, "sx": 1.04}], [0.7, {}], [1, {}]]},
  "spin_loop": {"kind": "loop", "label": "Rotation continue", "period": 3.0, "ease": "linear", "kf": [[0, {"r": 0}], [1, {"r": 360}]]},
  "zoom_slow": {"kind": "loop", "label": "Zoom lent avant", "span": true, "ease": "linear", "kf": [[0, {}], [1, {"s": 1.15}]]},
  "zoom_slow_out": {"kind": "loop", "label": "Zoom lent arrière", "span": true, "ease": "linear", "kf": [[0, {"s": 1.15}], [1, {}]]},
  "pan_left":  {"kind": "loop", "label": "Panoramique gauche", "for": ["media"], "span": true, "ease": "linear", "kf": [[0, {"dx": 0.04, "s": 1.12}], [1, {"dx": -0.04, "s": 1.12}]]},
  "pan_right": {"kind": "loop", "label": "Panoramique droite", "for": ["media"], "span": true, "ease": "linear", "kf": [[0, {"dx": -0.04, "s": 1.12}], [1, {"dx": 0.04, "s": 1.12}]]},
  "shimmer":   {"kind": "loop", "label": "Scintillement", "for": ["text"], "period": 1.4, "ease": "inOutSine", "per": "char", "stagger": 1, "ukf": [[0, {}], [0.5, {"o": 0.35}], [1, {}]]}
 }
}
